{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": [
        "uvx",
        "jcodemunch-mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "opencode-skills",
    "opencode-pty",
    "micode",
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode",
    "opencode-devcontainers",
    "oh-my-opencode-slim",
    "opencode-antigravity-auth@latest",
    "rtk"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "command": {
    "plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:./skills/planner/SKILL.md}\n\n$ARGUMENTS"
    },
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:./skills/tdd-guide/SKILL.md}\n\n$ARGUMENTS"
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:./skills/code-reviewer/SKILL.md}\n\n$ARGUMENTS"
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:./skills/security-reviewer/SKILL.md}\n\n$ARGUMENTS"
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:./skills/build-error-resolver/SKILL.md}\n\n$ARGUMENTS"
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:./skills/e2e-runner/SKILL.md}\n\n$ARGUMENTS"
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:./skills/refactor-cleaner/SKILL.md}\n\n$ARGUMENTS"
    },
    "orchestrate": {
      "description": "Orchestrate multiple agents for complex tasks",
      "template": "{file:./skills/planner/SKILL.md}\n\n$ARGUMENTS"
    },
    "learn": {
      "description": "Extract patterns and learnings from session",
      "template": "{file:./commands/learn.md}\n\n$ARGUMENTS"
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:./commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run verification loop",
      "template": "{file:./commands/verify.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:./commands/eval.md}\n\n$ARGUMENTS"
    },
    "update-docs": {
      "description": "Update documentation",
      "template": "{file:./skills/doc-updater/SKILL.md}\n\n$ARGUMENTS"
    },
    "update-codemaps": {
      "description": "Update codemaps",
      "template": "{file:./skills/doc-updater/SKILL.md}\n\n$ARGUMENTS"
    },
    "test-coverage": {
      "description": "Analyze test coverage",
      "template": "{file:./skills/tdd-guide/SKILL.md}\n\n$ARGUMENTS"
    },
    "setup-pm": {
      "description": "Configure package manager",
      "template": "{file:./commands/setup-pm.md}\n\n$ARGUMENTS"
    },
    "go-review": {
      "description": "Go code review",
      "template": "{file:./skills/go-reviewer/SKILL.md}\n\n$ARGUMENTS"
    },
    "go-test": {
      "description": "Go TDD workflow",
      "template": "{file:./skills/tdd-guide/SKILL.md}\n\n$ARGUMENTS"
    },
    "go-build": {
      "description": "Fix Go build errors",
      "template": "{file:./skills/go-build-resolver/SKILL.md}\n\n$ARGUMENTS"
    },
    "skill-create": {
      "description": "Generate skills from git history",
      "template": "{file:./commands/skill-create.md}\n\n$ARGUMENTS"
    },
    "instinct-status": {
      "description": "View learned instincts",
      "template": "{file:./commands/instinct-status.md}\n\n$ARGUMENTS"
    },
    "instinct-import": {
      "description": "Import instincts",
      "template": "{file:./commands/instinct-import.md}\n\n$ARGUMENTS"
    },
    "instinct-export": {
      "description": "Export instincts",
      "template": "{file:./commands/instinct-export.md}\n\n$ARGUMENTS"
    },
    "evolve": {
      "description": "Cluster instincts into skills",
      "template": "{file:./commands/evolve.md}\n\n$ARGUMENTS"
    },
    "rust-review": {
      "description": "Review Rust code for idiomatic patterns",
      "template": "{file:./skills/rust-reviewer/SKILL.md}\n\n$ARGUMENTS"
    },
    "rust-clippy-fmt-check": {
      "description": "Fix Rust clippy, fmt, and test errors",
      "template": "{file:./skills/rust-clippy-fmt-check-tester/SKILL.md}\n\n$ARGUMENTS"
    }
  },
  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modal GLM-5",
      "options": {
        "baseURL": "https://api.us-west-2.modal.direct/v1"
      },
      "models": {
        "zai-org/GLM-5-FP8": {
          "name": "GLM-5",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      }
    },
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiniMax via OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "minimax-m2.5-free": {
          "name": "MiniMax M2.5 Free",
          "limit": {
            "context": 1000000,
            "output": 8000
          }
        }
      }
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KiloCode via OpenCode",
      "options": {
        "baseURL": "https://opencode.ai/kilo/v1"
      },
      "models": {
        "minimax-m2.5-free": {
          "id": "minimax/minimax-m2.5",
          "name": "MiniMax M2.5 Free",
          "limit": {
            "context": 1000000,
            "output": 8000
          }
        }
      }
    },
    "cline": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1"
      },
      "models": {
        "minimax-m2.5-free": {
          "id": "minimax/minimax-m2.5",
          "name": "MiniMax M2.5 Free",
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "kat-coder-pro-free": {
          "id": "kwaipilot/kat-coder-pro",
          "name": "Kwaipilot KAT Coder Pro Free",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "glm-5-free": {
          "id": "z-ai/glm-5",
          "name": "GLM-5 Free",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nvidia/deepseek-ai/deepseek-v3.2": {
          "name": "DeepSeek V3.2",
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "costPerMillionTokens": {
            "input": 0.5,
            "output": 1.5
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "baseURL": "https://api.openai.com/v1"
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": {
            "context": 180000,
            "output": 16384
          }
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "limit": {
            "context": 180000,
            "output": 16384
          }
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT-5.3 Codex Spark",
          "limit": {
            "context": 180000,
            "output": 16384
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "hunter-alpha": {
          "name": "Hunter Alpha",
          "limit": {
            "context": 1050000,
            "output": 16384
          }
        },
        "healer-alpha": {
          "name": "Healer Alpha",
          "limit": {
            "context": 262000,
            "output": 16384
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "mcp_*": "ask"
  },
  "experimental": {
    "preemptive_compaction_threshold": false
  }
}